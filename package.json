{
  "private": true,
  "scripts": {
    "css": "tailwindcss -i _styles/main.css -o styles/main.css --watch",
    "css:build": "tailwindcss -i _styles/main.css -o styles/main.css --minify",
    "css:alt": "tailwindcss -c tailwind.alt.config.js -i _styles/alt.css -o styles/alt.css --watch",
    "css:alt:build": "tailwindcss -c tailwind.alt.config.js -i _styles/alt.css -o styles/alt.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
